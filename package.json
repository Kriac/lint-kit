{
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "lint": "pnpm -r lint",
    "lint:es": "eslint --fix",
    "lint:style": "stylelint **/*.{vue,css,scss} --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:docs": "pnpm -F @kriac/lint-kit-docs dev",
    "dev:demo": "pnpm -F @kriac/lint-kit-demo dev",
    "build": "pnpm -r build",
    "build:docs": "pnpm -F @kriac/lint-kit-docs build",
    "build:demo": "pnpm -F @kriac/lint-kit-demo build",
    "build:commit": "pnpm -F @kriac/commitlint-config build",
    "build:es": "pnpm -F @kriac/eslint-config build",
    "build:style": "pnpm -F @kriac/stylelint-config build",
    "build:kit": "pnpm -F @kriac/lint-kit build",
    "release:commit": "pnpm build:commit && pnpm -F @kriac/commitlint-config release",
    "release:es": "pnpm build:es && pnpm -F @kriac/eslint-config release",
    "release:style": "pnpm build:style && pnpm -F @kriac/stylelint-config release",
    "release:kit": "pnpm build:kit && pnpm -F @kriac/lint-kit release"
  },
  "devDependencies": {
    "@kriac/lint-kit": "workspace:*",
    "@types/node": "25.6.0",
    "commitlint": "20.3.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.7.2",
    "stylelint": "17.12.0",
    "typescript": "5.8.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,md}": [
      "prettier --write"
    ]
  }
}
