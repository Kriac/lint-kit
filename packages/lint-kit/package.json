{
  "name": "@kriac/lint-kit",
  "description": "@kriac/lint-kit",
  "author": "Kriac",
  "license": "MIT",
  "type": "module",
  "version": "0.6.0",
  "homepage": "https://github.com/Kriac/lint-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kriac/lint-kit.git"
  },
  "keywords": [
    "lint-kit",
    "lint-config"
  ],
  "bin": {
    "lint-kit": "./dist/cli.mjs"
  },
  "scripts": {
    "lint": "vue-tsc -b --noEmit",
    "build": "tsdown",
    "release": "pnpm publish --access public"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@kriac/commitlint-config": "workspace:*",
    "@kriac/eslint-config": "workspace:*",
    "@kriac/stylelint-config": "workspace:*",
    "cac": "7.1.0",
    "comment-json": "5.0.0",
    "commitlint": "21.2.4",
    "cosmiconfig": "10.0.1",
    "eslint": "10.14.0",
    "lint-staged": "17.6.0",
    "picocolors": "1.1.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsdown": "0.22.0",
    "vue-tsc": "3.2.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./commitlint": {
      "types": "./dist/commitlint.d.mts",
      "import": "./dist/commitlint.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.mts",
      "import": "./dist/stylelint.mjs"
    }
  }
}
