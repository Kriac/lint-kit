{
  "name": "@kriac/lint-kit",
  "description": "@kriac/lint-kit",
  "author": "Kriac",
  "license": "MIT",
  "type": "module",
  "version": "0.5.0",
  "homepage": "https://github.com/Kriac/lint-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kriac/lint-kit.git"
  },
  "keywords": [
    "lint-kit",
    "lint-config"
  ],
  "bin": {
    "lint-kit": "./dist/cli.mjs"
  },
  "scripts": {
    "lint": "vue-tsc -b --noEmit",
    "build": "tsdown",
    "release": "pnpm publish --access public"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@kriac/commitlint-config": "workspace:*",
    "@kriac/eslint-config": "workspace:*",
    "@kriac/stylelint-config": "workspace:*",
    "cac": "7.1.0",
    "commitlint": "20.3.0",
    "cosmiconfig": "9.0.2",
    "eslint": "9.39.4",
    "stylelint": "17.12.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "tsdown": "0.22.0",
    "vue-tsc": "3.2.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./commitlint": {
      "types": "./dist/commitlint.d.mts",
      "import": "./dist/commitlint.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.mts",
      "import": "./dist/stylelint.mjs"
    }
  }
}
